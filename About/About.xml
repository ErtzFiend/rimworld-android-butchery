<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Android Butchery</name>
  <author>ertzfiend</author>
  <packageId>ertzfiend.androidbutchery</packageId>
  <description>Allows android and droid corpses to be butchered at the butcher table, recovering half of their crafting materials. Droids produce steel and components; androids produce plasteel and advanced components.</description>
  <supportedVersions>
    <li>1.7</li>
  </supportedVersions>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
    <li>
      <packageId>ChJees.Androids14</packageId>
      <displayName>Androids for RW 1.6</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=2889326293</steamWorkshopUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>ChJees.Androids14</li>
  </loadAfter>
</ModMetaData>
